{
  "headers": [
    {
      "source": "/sitemap(.*)\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/atom\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/atom+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/og-api",
      "destination": "/api/og-injector"
    },
    {
      "source": "/sb-rest/:path*",
      "destination": "https://ssmkasmtdnojdicdpdfg.supabase.co/rest/v1/:path*"
    },
    {
      "source": "/sb-auth/:path*",
      "destination": "https://ssmkasmtdnojdicdpdfg.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/s/:id",
      "destination": "/api/og-injector?s=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
